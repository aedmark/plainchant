{
  "name": "plainchant",
  "version": "1.0.0",
  "description": "A lightweight screenwriting app: type plain text (Fountain), get a formatted screenplay.",
  "main": "index.html",
  "scripts": {
    "test": "node test/run.js",
    "test:browser": "bash test/run-headless.sh",
    "test:browser:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File test/run-headless.ps1",
    "serve": "python3 -m http.server 8080",
    "tauri:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true
}
